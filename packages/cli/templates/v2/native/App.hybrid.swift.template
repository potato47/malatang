import FIA

@main
enum App {
    @MainActor
    static func main() {
        FIAApplication.run { runtime in
            runtime.windows.registerFIAWeb("main", route: "/", title: __FIA_APP_NAME_JSON__)
            runtime.windows.registerSwiftUI("settings", title: "Settings") {
                ContentView()
            }
        }
    }
}
