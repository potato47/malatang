import { defineApp } from "@semicoder/fia/runtime";

interface EchoRequest {
  id: string;
  message: string;
}

export default defineApp({
  routes: {
    "/api/hello": () => Response.json({
      message: "Hello from __FIA_PACKAGE_NAME__",
      timestamp: new Date().toISOString(),
    }),
    "/ws": (request, bunServer) => {
      if (bunServer.upgrade(request)) return;
      return new Response("WebSocket upgrade required", { status: 426 });
    },
  },
  websocket: {
    maxPayloadLength: 64 * 1024,
    message(socket, message) {
      if (typeof message !== "string") {
        socket.close(1003, "text messages only");
        return;
      }
      try {
        const request = JSON.parse(message) as Partial<EchoRequest>;
        if (typeof request.id !== "string" || typeof request.message !== "string") {
          socket.close(1007, "invalid echo request");
          return;
        }
        socket.send(JSON.stringify({ id: request.id, echo: request.message }));
      } catch {
        socket.close(1007, "invalid JSON");
      }
    },
  },
});
