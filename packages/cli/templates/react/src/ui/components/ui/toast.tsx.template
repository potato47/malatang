import { Toast as BaseToast } from "@base-ui/react/toast";
import { AlertCircle, CheckCircle2, Info, TriangleAlert, X } from "lucide-react";
import * as React from "react";

export type ToastTone = "success" | "error" | "warning" | "info";

export interface ToastOptions {
  title: string;
  description?: string;
  timeout?: number;
}

export interface ToastApi {
  success: (options: ToastOptions) => string;
  error: (options: ToastOptions) => string;
  warning: (options: ToastOptions) => string;
  info: (options: ToastOptions) => string;
}

interface ToastData {
  tone: ToastTone;
}

const ToastContext = React.createContext<ToastApi | null>(null);

const icons = {
  success: CheckCircle2,
  error: AlertCircle,
  warning: TriangleAlert,
  info: Info,
};

const iconTones = {
  success: "text-ui-success",
  error: "text-ui-danger",
  warning: "text-ui-warning",
  info: "text-ui-info",
} as const;

function ToastBridge({ children }: { children: React.ReactNode }) {
  const manager = BaseToast.useToastManager<ToastData>();

  const api = React.useMemo<ToastApi>(() => {
    const add = (tone: ToastTone, options: ToastOptions) =>
      manager.add({
        ...options,
        type: tone,
        priority: tone === "error" ? "high" : "low",
        data: { tone },
      });
    return {
      success: (options) => add("success", options),
      error: (options) => add("error", options),
      warning: (options) => add("warning", options),
      info: (options) => add("info", options),
    };
  }, [manager]);

  return (
    <ToastContext.Provider value={api}>
      {children}
      <BaseToast.Portal>
        <BaseToast.Viewport className="fixed right-5 bottom-5 z-[90] w-[min(360px,calc(100vw-32px))]">
          {manager.toasts.map((toast) => {
            const tone = toast.data?.tone ?? "info";
            const Icon = icons[tone];
            return (
              <BaseToast.Root
                className="absolute right-0 bottom-0 w-full rounded-ui-lg border border-ui-border bg-ui-surface text-ui-text shadow-ui-popup transition-[opacity,transform,translate] duration-200 [--toast-gap:8px] [transform:translateX(var(--toast-swipe-movement-x))_translateY(calc(var(--toast-swipe-movement-y)-(var(--toast-index)*var(--toast-gap))))] data-ending-style:translate-y-3 data-ending-style:opacity-0 data-limited:opacity-0 data-starting-style:translate-y-3 data-starting-style:opacity-0"
                data-tone={tone}
                key={toast.id}
                toast={toast}
              >
                <BaseToast.Content className="flex min-h-16 items-start gap-2.5 p-3">
                  <Icon className={`mt-0.5 ${iconTones[tone]}`} size={17} aria-hidden />
                  <div className="flex min-w-0 flex-1 flex-col gap-0.5">
                    <BaseToast.Title className="text-[13px] font-semibold" />
                    <BaseToast.Description className="text-[11px] text-ui-text-muted" />
                  </div>
                  <BaseToast.Close
                    className="inline-flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-ui-sm border-0 bg-transparent text-ui-text-muted hover:bg-ui-surface-hover hover:text-ui-text"
                    aria-label="Close notification"
                  >
                    <X size={14} />
                  </BaseToast.Close>
                </BaseToast.Content>
              </BaseToast.Root>
            );
          })}
        </BaseToast.Viewport>
      </BaseToast.Portal>
    </ToastContext.Provider>
  );
}

export function ToastProvider({ children }: { children: React.ReactNode }) {
  return (
    <BaseToast.Provider limit={4} timeout={4500}>
      <ToastBridge>{children}</ToastBridge>
    </BaseToast.Provider>
  );
}

export function useToast() {
  const context = React.useContext(ToastContext);
  if (!context) {
    throw new Error("useToast must be used within ToastProvider");
  }
  return context;
}
