import { Avatar as BaseAvatar } from "@base-ui/react/avatar";
import { Button as BaseButton } from "@base-ui/react/button";
import { Progress as BaseProgress } from "@base-ui/react/progress";
import { cva, type VariantProps } from "class-variance-authority";
import { LoaderCircle } from "lucide-react";
import * as React from "react";

import { cn } from "./cn";

const buttonVariants = cva(
  "relative inline-flex shrink-0 cursor-pointer select-none items-center justify-center whitespace-nowrap rounded-ui-md border border-transparent px-[11px] text-[13px] leading-none font-[560] text-ui-text transition-[background-color,border-color,color,opacity] duration-150 disabled:cursor-not-allowed disabled:opacity-45 data-disabled:cursor-not-allowed data-disabled:opacity-45",
  {
    variants: {
      variant: {
        primary:
          "border-ui-accent bg-ui-accent text-ui-on-accent hover:not-data-disabled:border-ui-accent-hover hover:not-data-disabled:bg-ui-accent-hover",
        secondary:
          "border-ui-border bg-ui-surface hover:not-data-disabled:bg-ui-surface-hover",
        ghost: "text-ui-text-muted hover:not-data-disabled:bg-ui-surface-hover",
        danger:
          "border-ui-danger bg-ui-danger text-white hover:not-data-disabled:border-ui-danger-hover hover:not-data-disabled:bg-ui-danger-hover",
      },
      size: {
        sm: "min-h-7 px-[9px] text-xs",
        md: "min-h-8",
        lg: "min-h-9 px-3.5 text-sm",
      },
    },
    defaultVariants: {
      variant: "secondary",
      size: "md",
    },
  },
);

export interface ButtonProps
  extends React.ComponentPropsWithoutRef<typeof BaseButton>, VariantProps<typeof buttonVariants> {
  loading?: boolean;
  iconOnly?: boolean;
}

export const Button = React.forwardRef<HTMLElement, ButtonProps>(function Button(
  { className, variant, size, loading = false, iconOnly = false, disabled, children, ...props },
  ref,
) {
  return (
    <BaseButton
      ref={ref}
      className={cn(
        buttonVariants({ variant, size }),
        iconOnly && "w-8 px-0",
        loading &&
          "cursor-wait opacity-100 disabled:cursor-wait disabled:opacity-100 data-disabled:cursor-wait data-disabled:opacity-100",
        className,
      )}
      disabled={disabled || loading}
      focusableWhenDisabled={loading}
      aria-busy={loading || undefined}
      data-loading={loading || undefined}
      {...props}
    >
      <span
        className={cn(
          "inline-flex items-center justify-center gap-[7px]",
          loading && "invisible",
        )}
      >
        {children}
      </span>
      {loading ? (
        <span
          className="pointer-events-none absolute inset-0 flex items-center justify-center"
          aria-hidden
        >
          <LoaderCircle className="animate-[ui-spin_800ms_linear_infinite]" size={15} />
        </span>
      ) : null}
    </BaseButton>
  );
});

export const IconButton = React.forwardRef<HTMLElement, ButtonProps>(
  function IconButton(props, ref) {
    return <Button ref={ref} iconOnly {...props} />;
  },
);

const badgeVariants = cva(
  "inline-flex min-h-[22px] items-center justify-center gap-1.5 whitespace-nowrap rounded-full border border-transparent bg-ui-surface-subtle px-2 py-0.5 text-[11px] leading-none font-semibold text-ui-text-muted",
  {
    variants: {
      tone: {
        neutral: "border-ui-border",
        accent: "bg-ui-accent-soft text-ui-accent-text",
        success: "bg-ui-success-soft text-ui-success",
        warning: "bg-ui-warning-soft text-ui-warning",
        danger: "bg-ui-danger-soft text-ui-danger",
      },
    },
    defaultVariants: { tone: "neutral" },
  },
);

export interface BadgeProps
  extends React.HTMLAttributes<HTMLSpanElement>, VariantProps<typeof badgeVariants> {
  dot?: boolean;
}

export function Badge({ className, tone, dot = false, children, ...props }: BadgeProps) {
  return (
    <span className={cn(badgeVariants({ tone }), className)} {...props}>
      {dot ? <span className="size-1.5 rounded-full bg-current" aria-hidden /> : null}
      {children}
    </span>
  );
}

const avatarSizes = {
  sm: "size-6 text-[9px]",
  md: "size-8 text-[11px]",
  lg: "size-10 text-[13px]",
} as const;

export interface AvatarProps extends React.ComponentPropsWithoutRef<typeof BaseAvatar.Root> {
  src?: string;
  alt?: string;
  fallback: string;
  size?: keyof typeof avatarSizes;
}

export const Avatar = React.forwardRef<HTMLSpanElement, AvatarProps>(function Avatar(
  { className, src, alt = "", fallback, size = "md", ...props },
  ref,
) {
  return (
    <BaseAvatar.Root
      ref={ref}
      className={cn(
        "relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full border border-ui-border bg-ui-accent-soft font-semibold text-ui-accent-text",
        avatarSizes[size],
        className,
      )}
      {...props}
    >
      {src ? <BaseAvatar.Image className="size-full object-cover" src={src} alt={alt} /> : null}
      <BaseAvatar.Fallback className="flex size-full items-center justify-center">
        {fallback.slice(0, 2).toUpperCase()}
      </BaseAvatar.Fallback>
    </BaseAvatar.Root>
  );
});

export interface ProgressProps extends React.ComponentPropsWithoutRef<typeof BaseProgress.Root> {
  label?: string;
  showValue?: boolean;
}

export function Progress({ className, label, showValue = false, value, ...props }: ProgressProps) {
  return (
    <BaseProgress.Root className={cn("w-full", className)} value={value} {...props}>
      {label || showValue ? (
        <div className="mb-[7px] flex items-center justify-between text-[11px] text-ui-text-muted">
          <BaseProgress.Label>{label}</BaseProgress.Label>
          {showValue ? (
            <BaseProgress.Value>{(formattedValue) => formattedValue}</BaseProgress.Value>
          ) : null}
        </div>
      ) : null}
      <BaseProgress.Track className="relative h-[5px] overflow-hidden rounded-full bg-ui-surface-subtle">
        <BaseProgress.Indicator className="h-full rounded-[inherit] bg-ui-accent transition-transform duration-200 [transform:translateX(calc(-100%+var(--progress-value)*1%))]" />
      </BaseProgress.Track>
    </BaseProgress.Root>
  );
}
