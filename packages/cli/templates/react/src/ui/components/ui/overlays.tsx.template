import { Dialog as BaseDialog } from "@base-ui/react/dialog";
import { Popover as BasePopover } from "@base-ui/react/popover";
import { Tooltip as BaseTooltip } from "@base-ui/react/tooltip";
import { X } from "lucide-react";
import * as React from "react";

import { cn } from "./cn";

export interface TooltipProps extends Omit<
  React.ComponentPropsWithoutRef<typeof BaseTooltip.Root>,
  "children"
> {
  content: React.ReactNode;
  children: React.ReactElement;
  side?: React.ComponentPropsWithoutRef<typeof BaseTooltip.Positioner>["side"];
}

export function Tooltip({ content, children, side = "top", ...props }: TooltipProps) {
  return (
    <BaseTooltip.Root {...props}>
      <BaseTooltip.Trigger render={children} />
      <BaseTooltip.Portal>
        <BaseTooltip.Positioner className="z-[60] outline-none" side={side} sideOffset={6}>
          <BaseTooltip.Popup className="origin-[var(--transform-origin)] rounded-ui-sm bg-ui-text px-[7px] py-[5px] text-[11px] leading-tight text-ui-surface shadow-ui-popup transition-[opacity,transform,scale] duration-150 data-ending-style:scale-[0.97] data-ending-style:opacity-0 data-starting-style:scale-[0.97] data-starting-style:opacity-0">
            {content}
          </BaseTooltip.Popup>
        </BaseTooltip.Positioner>
      </BaseTooltip.Portal>
    </BaseTooltip.Root>
  );
}

export interface PopoverProps extends Omit<
  React.ComponentPropsWithoutRef<typeof BasePopover.Root>,
  "children"
> {
  trigger: React.ReactElement;
  title?: React.ReactNode;
  description?: React.ReactNode;
  children: React.ReactNode;
  align?: "start" | "center" | "end";
  side?: React.ComponentPropsWithoutRef<typeof BasePopover.Positioner>["side"];
  className?: string;
}

export function Popover({
  trigger,
  title,
  description,
  children,
  align = "center",
  side = "bottom",
  className,
  ...props
}: PopoverProps) {
  return (
    <BasePopover.Root {...props}>
      <BasePopover.Trigger render={trigger} />
      <BasePopover.Portal>
        <BasePopover.Positioner
          className="z-50 outline-none"
          side={side}
          align={align}
          sideOffset={8}
        >
          <BasePopover.Popup
            className={cn(
              "w-[min(300px,var(--available-width))] origin-[var(--transform-origin)] rounded-ui-lg border border-ui-border bg-ui-surface p-3.5 text-ui-text shadow-ui-popup transition-[opacity,transform,translate,scale] duration-150 data-ending-style:scale-[0.98] data-ending-style:-translate-y-0.5 data-ending-style:opacity-0 data-starting-style:scale-[0.98] data-starting-style:-translate-y-0.5 data-starting-style:opacity-0",
              className,
            )}
          >
            {(title || description) && (
              <header className="mb-3 flex flex-col gap-[3px]">
                {title ? (
                  <BasePopover.Title className="m-0 text-[13px] font-semibold">
                    {title}
                  </BasePopover.Title>
                ) : null}
                {description ? (
                  <BasePopover.Description className="mt-[3px] text-xs leading-normal font-normal text-ui-text-muted">
                    {description}
                  </BasePopover.Description>
                ) : null}
              </header>
            )}
            {children}
          </BasePopover.Popup>
        </BasePopover.Positioner>
      </BasePopover.Portal>
    </BasePopover.Root>
  );
}

export interface DialogProps extends Omit<
  React.ComponentPropsWithoutRef<typeof BaseDialog.Root>,
  "children"
> {
  trigger?: React.ReactElement;
  title: React.ReactNode;
  description?: React.ReactNode;
  children: React.ReactNode;
  footer?: React.ReactNode;
  className?: string;
}

export function Dialog({
  trigger,
  title,
  description,
  children,
  footer,
  className,
  ...props
}: DialogProps) {
  return (
    <BaseDialog.Root {...props}>
      {trigger ? <BaseDialog.Trigger render={trigger} /> : null}
      <BaseDialog.Portal>
        <BaseDialog.Backdrop className="fixed inset-0 z-[70] bg-ui-overlay transition-opacity duration-150 data-ending-style:opacity-0 data-starting-style:opacity-0" />
        <BaseDialog.Viewport className="fixed inset-0 z-[71] flex items-center justify-center p-5">
          <BaseDialog.Popup
            className={cn(
              "w-[min(440px,100%)] rounded-ui-lg border border-ui-border bg-ui-surface text-ui-text shadow-ui-popup transition-[opacity,transform,translate,scale] duration-150 data-ending-style:translate-y-1.5 data-ending-style:scale-[0.985] data-ending-style:opacity-0 data-starting-style:translate-y-1.5 data-starting-style:scale-[0.985] data-starting-style:opacity-0",
              className,
            )}
          >
            <header className="flex items-start justify-between gap-4 px-[18px] pt-[18px] pb-3.5">
              <div>
                <BaseDialog.Title className="m-0 text-base font-[680] tracking-[-0.01em]">
                  {title}
                </BaseDialog.Title>
                {description ? (
                  <BaseDialog.Description className="mt-[3px] text-xs leading-normal font-normal text-ui-text-muted">
                    {description}
                  </BaseDialog.Description>
                ) : null}
              </div>
              <BaseDialog.Close
                className="inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-ui-sm border-0 bg-transparent text-ui-text-muted hover:bg-ui-surface-hover hover:text-ui-text"
                aria-label="Close dialog"
              >
                <X size={16} />
              </BaseDialog.Close>
            </header>
            <div className="px-[18px] pb-[18px]">{children}</div>
            {footer ? (
              <footer className="flex justify-end gap-2 border-t border-ui-border bg-ui-surface-subtle px-[18px] py-3">
                {footer}
              </footer>
            ) : null}
          </BaseDialog.Popup>
        </BaseDialog.Viewport>
      </BaseDialog.Portal>
    </BaseDialog.Root>
  );
}

export const DialogClose = BaseDialog.Close;
