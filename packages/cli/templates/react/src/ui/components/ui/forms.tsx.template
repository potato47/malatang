import { Checkbox as BaseCheckbox } from "@base-ui/react/checkbox";
import { Combobox as BaseCombobox } from "@base-ui/react/combobox";
import type { ComboboxRootProps } from "@base-ui/react/combobox";
import { Field as BaseField } from "@base-ui/react/field";
import { Input as BaseInput } from "@base-ui/react/input";
import { Radio as BaseRadio } from "@base-ui/react/radio";
import { RadioGroup as BaseRadioGroup } from "@base-ui/react/radio-group";
import { Select as BaseSelect } from "@base-ui/react/select";
import type { SelectRootProps } from "@base-ui/react/select";
import { Switch as BaseSwitch } from "@base-ui/react/switch";
import { Check, ChevronDown, Search, X } from "lucide-react";
import * as React from "react";

import { cn } from "./cn";

const inputClass =
  "h-8 w-full rounded-ui-md border border-ui-border bg-ui-surface px-2.5 text-[13px] text-ui-text outline-none transition-[border-color,background-color,box-shadow] duration-150 placeholder:text-ui-text-faint hover:not-disabled:border-ui-border-strong focus:border-ui-focus focus:shadow-[0_0_0_2px_color-mix(in_srgb,var(--ui-focus)_16%,transparent)] disabled:cursor-not-allowed disabled:bg-ui-surface-subtle disabled:text-ui-text-faint group-data-invalid/field:border-ui-danger group-data-invalid/field:shadow-[0_0_0_2px_color-mix(in_srgb,var(--ui-danger)_12%,transparent)]";

const choiceRowClass = "flex min-w-0 cursor-pointer items-start gap-2.5 select-none";
const choiceCopyClass = "flex min-w-0 flex-1 flex-col gap-0.5";
const choiceLabelClass = "text-[13px] font-[540] text-ui-text";
const choiceDescriptionClass = "text-[11px] leading-[1.45] text-ui-text-muted";
const choiceControlClass =
  "mt-0.5 inline-flex size-4 shrink-0 cursor-inherit items-center justify-center border border-ui-border-strong bg-ui-surface text-ui-on-accent transition-colors duration-150 data-checked:border-ui-accent data-checked:bg-ui-accent";
const popupClass =
  "origin-[var(--transform-origin)] rounded-ui-lg border border-ui-border bg-ui-surface text-ui-text shadow-ui-popup transition-[opacity,transform,translate,scale] duration-150 data-ending-style:scale-[0.98] data-ending-style:-translate-y-0.5 data-ending-style:opacity-0 data-starting-style:scale-[0.98] data-starting-style:-translate-y-0.5 data-starting-style:opacity-0";
const listItemClass =
  "grid min-h-[34px] cursor-default grid-cols-[18px_minmax(0,1fr)] items-center gap-1.5 rounded-ui-sm px-2 py-[5px] text-[13px] text-ui-text outline-none data-disabled:opacity-45 data-highlighted:bg-ui-surface-hover data-selected:text-ui-accent-text";

export interface FieldProps extends Omit<
  React.ComponentPropsWithoutRef<typeof BaseField.Root>,
  "children"
> {
  label?: React.ReactNode;
  description?: React.ReactNode;
  error?: React.ReactNode;
  optional?: boolean;
  children: React.ReactNode;
}

export function Field({
  label,
  description,
  error,
  optional,
  className,
  children,
  invalid,
  ...props
}: FieldProps) {
  return (
    <BaseField.Root
      className={cn("group/field flex min-w-0 flex-col gap-1.5", className)}
      invalid={invalid ?? Boolean(error)}
      {...props}
    >
      {label ? (
        <BaseField.Label className="flex items-center justify-between gap-2 text-xs font-semibold text-ui-text">
          <span>{label}</span>
          {optional ? (
            <span className="text-[11px] font-normal text-ui-text-muted">Optional</span>
          ) : null}
        </BaseField.Label>
      ) : null}
      {children}
      {description && !error ? (
        <BaseField.Description className="text-[11px] font-normal text-ui-text-muted">
          {description}
        </BaseField.Description>
      ) : null}
      {error ? (
        <BaseField.Error className="text-[11px] text-ui-danger" match>
          {error}
        </BaseField.Error>
      ) : null}
    </BaseField.Root>
  );
}

export type InputProps = React.ComponentPropsWithoutRef<typeof BaseInput>;

export const Input = React.forwardRef<HTMLElement, InputProps>(function Input(
  { className, ...props },
  ref,
) {
  return <BaseInput ref={ref} className={cn(inputClass, className)} {...props} />;
});

export type TextareaProps = React.ComponentPropsWithoutRef<"textarea">;

export const Textarea = React.forwardRef<HTMLTextAreaElement, TextareaProps>(function Textarea(
  { className, ...props },
  ref,
) {
  return (
    <BaseField.Control
      ref={ref as React.Ref<HTMLElement>}
      render={
        <textarea
          ref={ref}
          className={cn(inputClass, "h-auto min-h-[76px] resize-y px-2.5 py-2", className)}
          {...props}
        />
      }
    />
  );
});

export interface CheckboxProps extends React.ComponentPropsWithoutRef<typeof BaseCheckbox.Root> {
  label: React.ReactNode;
  description?: React.ReactNode;
}

export function Checkbox({ label, description, className, ...props }: CheckboxProps) {
  return (
    <label className={cn(choiceRowClass, props.disabled && "cursor-not-allowed opacity-50")}>
      <BaseCheckbox.Root
        className={cn(choiceControlClass, "rounded-ui-sm", className)}
        {...props}
      >
        <BaseCheckbox.Indicator className="flex">
          <Check size={13} strokeWidth={2.5} />
        </BaseCheckbox.Indicator>
      </BaseCheckbox.Root>
      <span className={choiceCopyClass}>
        <span className={choiceLabelClass}>{label}</span>
        {description ? <span className={choiceDescriptionClass}>{description}</span> : null}
      </span>
    </label>
  );
}

export interface RadioOption {
  value: string;
  label: React.ReactNode;
  description?: React.ReactNode;
  disabled?: boolean;
}

export interface RadioGroupProps extends Omit<
  React.ComponentPropsWithoutRef<typeof BaseRadioGroup>,
  "children"
> {
  options: RadioOption[];
}

export function RadioGroup({ options, className, ...props }: RadioGroupProps) {
  return (
    <BaseRadioGroup className={cn("flex flex-col gap-3", className)} {...props}>
      {options.map((option) => (
        <label
          className={cn(choiceRowClass, option.disabled && "cursor-not-allowed opacity-50")}
          key={option.value}
        >
          <BaseRadio.Root
            className={cn(choiceControlClass, "rounded-full")}
            value={option.value}
            disabled={option.disabled}
          >
            <BaseRadio.Indicator className="size-1.5 rounded-full bg-ui-on-accent" />
          </BaseRadio.Root>
          <span className={choiceCopyClass}>
            <span className={choiceLabelClass}>{option.label}</span>
            {option.description ? (
              <span className={choiceDescriptionClass}>{option.description}</span>
            ) : null}
          </span>
        </label>
      ))}
    </BaseRadioGroup>
  );
}

export interface SwitchProps extends React.ComponentPropsWithoutRef<typeof BaseSwitch.Root> {
  label: React.ReactNode;
  description?: React.ReactNode;
}

export function Switch({ label, description, className, ...props }: SwitchProps) {
  return (
    <label
      className={cn(
        "flex min-w-0 cursor-pointer items-center justify-between gap-2.5 select-none",
        props.disabled && "cursor-not-allowed opacity-50",
      )}
    >
      <span className={choiceCopyClass}>
        <span className={choiceLabelClass}>{label}</span>
        {description ? <span className={choiceDescriptionClass}>{description}</span> : null}
      </span>
      <BaseSwitch.Root
        className={cn(
          "group/switch relative inline-flex h-[19px] w-[34px] shrink-0 cursor-inherit items-center rounded-full border border-ui-border-strong bg-ui-surface-subtle p-0.5 transition-colors duration-150 data-checked:border-ui-accent data-checked:bg-ui-accent",
          className,
        )}
        {...props}
      >
        <BaseSwitch.Thumb className="size-[13px] translate-x-0 rounded-full bg-ui-text-muted transition-[transform,translate,background-color] duration-150 group-data-checked/switch:translate-x-[15px] group-data-checked/switch:bg-ui-on-accent" />
      </BaseSwitch.Root>
    </label>
  );
}

export interface SelectOption {
  value: string;
  label: string;
  description?: string;
}

export interface SelectProps extends Omit<
  SelectRootProps<string, false>,
  "children" | "items" | "multiple"
> {
  options: SelectOption[];
  placeholder?: string;
  className?: string;
}

export function Select({
  options,
  placeholder = "Select an option",
  className,
  ...props
}: SelectProps) {
  return (
    <BaseSelect.Root<string> items={options} {...props}>
      <BaseSelect.Trigger
        className={cn(
          "flex min-h-8 w-full min-w-[180px] cursor-pointer items-center justify-between gap-2 rounded-ui-md border border-ui-border bg-ui-surface px-[9px] text-[13px] text-ui-text transition-[border-color,background-color,box-shadow] duration-150 hover:not-data-disabled:border-ui-border-strong data-disabled:cursor-not-allowed data-disabled:bg-ui-surface-subtle data-disabled:text-ui-text-faint data-placeholder:text-ui-text-faint data-popup-open:border-ui-focus data-popup-open:shadow-[0_0_0_2px_color-mix(in_srgb,var(--ui-focus)_16%,transparent)]",
          className,
        )}
      >
        <BaseSelect.Value
          className="min-w-0 flex-1 truncate text-left"
          placeholder={placeholder}
        />
        <BaseSelect.Icon className="flex text-ui-text-muted">
          <ChevronDown size={15} />
        </BaseSelect.Icon>
      </BaseSelect.Trigger>
      <BaseSelect.Portal>
        <BaseSelect.Positioner className="z-50 outline-none" sideOffset={6}>
          <BaseSelect.Popup
            className={cn(
              popupClass,
              "max-h-[min(320px,var(--available-height))] w-[var(--anchor-width)] max-w-[var(--available-width)] overflow-auto p-1",
            )}
          >
            <BaseSelect.List>
              {options.map((option) => (
                <BaseSelect.Item
                  className={listItemClass}
                  key={option.value}
                  value={option.value}
                >
                  <span className="flex size-[18px] items-center justify-center text-ui-accent">
                    <BaseSelect.ItemIndicator className="flex">
                      <Check size={14} />
                    </BaseSelect.ItemIndicator>
                  </span>
                  <span className="flex min-w-0 flex-col">
                    <BaseSelect.ItemText>{option.label}</BaseSelect.ItemText>
                    {option.description ? (
                      <span className="text-[10px] text-ui-text-muted">{option.description}</span>
                    ) : null}
                  </span>
                </BaseSelect.Item>
              ))}
            </BaseSelect.List>
          </BaseSelect.Popup>
        </BaseSelect.Positioner>
      </BaseSelect.Portal>
    </BaseSelect.Root>
  );
}

export interface ComboboxOption {
  value: string;
  label: string;
  meta?: string;
}

export interface ComboboxProps extends Omit<
  ComboboxRootProps<ComboboxOption, false>,
  | "children"
  | "items"
  | "multiple"
  | "itemToStringLabel"
  | "itemToStringValue"
  | "isItemEqualToValue"
> {
  options: ComboboxOption[];
  placeholder?: string;
  className?: string;
  ariaLabel?: string;
}

export function Combobox({
  options,
  placeholder = "Search options",
  className,
  ariaLabel,
  ...props
}: ComboboxProps) {
  return (
    <BaseCombobox.Root<ComboboxOption>
      items={options}
      itemToStringLabel={(item) => item.label}
      itemToStringValue={(item) => item.value}
      isItemEqualToValue={(item, value) => item.value === value.value}
      {...props}
    >
      <BaseCombobox.InputGroup
        className={cn(
          "group/combobox flex min-h-8 w-full items-center rounded-ui-md border border-ui-border bg-ui-surface py-0 pr-1 pl-[9px] text-ui-text transition-[border-color,background-color,box-shadow] duration-150 hover:border-ui-border-strong focus-within:border-ui-focus focus-within:shadow-[0_0_0_2px_color-mix(in_srgb,var(--ui-focus)_16%,transparent)]",
          className,
        )}
      >
        <Search className="shrink-0 text-ui-text-muted" size={14} aria-hidden />
        <BaseCombobox.Input
          aria-label={ariaLabel}
          className="h-[30px] w-full min-w-0 border-0 bg-transparent px-[7px] text-[13px] text-ui-text outline-none placeholder:text-ui-text-faint"
          placeholder={placeholder}
        />
        <BaseCombobox.Clear
          className="hidden size-[25px] shrink-0 cursor-pointer items-center justify-center rounded-ui-sm border-0 bg-transparent text-ui-text-muted group-has-[input:not(:placeholder-shown)]/combobox:flex"
          aria-label="Clear selection"
        >
          <X size={13} />
        </BaseCombobox.Clear>
        <BaseCombobox.Trigger
          className="flex size-[25px] shrink-0 cursor-pointer items-center justify-center rounded-ui-sm border-0 bg-transparent text-ui-text-muted"
          aria-label="Open options"
        >
          <ChevronDown size={14} />
        </BaseCombobox.Trigger>
      </BaseCombobox.InputGroup>
      <BaseCombobox.Portal>
        <BaseCombobox.Positioner className="z-50 outline-none" sideOffset={6}>
          <BaseCombobox.Popup
            className={cn(
              popupClass,
              "max-h-[min(320px,var(--available-height))] w-[var(--anchor-width)] max-w-[var(--available-width)] overflow-auto p-1",
            )}
          >
            <BaseCombobox.Empty className="px-3 py-5 text-center text-xs text-ui-text-muted">
              No matching options
            </BaseCombobox.Empty>
            <BaseCombobox.List className="max-h-[min(288px,var(--available-height))] overflow-auto">
              {(option: ComboboxOption) => (
                <BaseCombobox.Item key={option.value} value={option} className={listItemClass}>
                  <span className="flex size-[18px] items-center justify-center text-ui-accent">
                    <BaseCombobox.ItemIndicator className="flex">
                      <Check size={14} />
                    </BaseCombobox.ItemIndicator>
                  </span>
                  <span className="flex min-w-0 flex-col">
                    <span>{option.label}</span>
                    {option.meta ? (
                      <span className="text-[10px] text-ui-text-muted">{option.meta}</span>
                    ) : null}
                  </span>
                </BaseCombobox.Item>
              )}
            </BaseCombobox.List>
          </BaseCombobox.Popup>
        </BaseCombobox.Positioner>
      </BaseCombobox.Portal>
    </BaseCombobox.Root>
  );
}
