import { useCallback, useEffect, useState } from "react";
import { mcp } from "@semicoder/fia/mcp";
import { native, type FIANativeState } from "@semicoder/fia/native";
import {
  AppWindow,
  Moon,
  Monitor,
  PanelTop,
  Radio,
  Sparkles,
  Sun,
} from "lucide-react";
import type { Greeting } from "../shared/types";
import {
  Badge,
  Button,
  IconButton,
  Menu,
  Tooltip,
  useTheme,
  useToast,
  type BadgeProps,
} from "./components/ui";

type Status = "idle" | "success" | "error";

const statusTone: Record<Status, BadgeProps["tone"]> = {
  idle: "neutral",
  success: "success",
  error: "danger",
};

function ThemeMenu() {
  const { theme, resolvedTheme, setTheme } = useTheme();
  const ThemeIcon = resolvedTheme === "dark" ? Moon : Sun;

  return (
    <Menu
      trigger={
        <IconButton variant="ghost" aria-label="Change color theme">
          <ThemeIcon size={16} />
        </IconButton>
      }
      items={[
        {
          id: "theme-system",
          label: "System",
          icon: <Monitor size={14} />,
          checked: theme === "system",
          onSelect: () => setTheme("system"),
        },
        {
          id: "theme-light",
          label: "Light",
          icon: <Sun size={14} />,
          checked: theme === "light",
          onSelect: () => setTheme("light"),
        },
        {
          id: "theme-dark",
          label: "Dark",
          icon: <Moon size={14} />,
          checked: theme === "dark",
          onSelect: () => setTheme("dark"),
        },
      ]}
    />
  );
}

export function App() {
  const toast = useToast();
  const [mcpStatus, setMcpStatus] = useState<Status>("idle");
  const [mcpMessage, setMcpMessage] = useState("Ready to call the bundled application MCP server.");
  const [nativeStatus, setNativeStatus] = useState<Status>("idle");
  const [nativeMessage, setNativeMessage] = useState("Checking the FIA native MCP server …");
  const [desktopState, setDesktopState] = useState<FIANativeState | null>(null);

  const callApp = useCallback(async () => {
    try {
      const result = await mcp.server("app").callTool({
        name: "greet",
        arguments: { name: "FIA" },
      });
      const greeting = result.structuredContent as Greeting;
      const message = `${greeting.message} · ${new Date(greeting.timestamp).toLocaleTimeString()}`;
      setMcpStatus("success");
      setMcpMessage(message);
      toast.success({ title: "Application MCP responded", description: greeting.message });
    } catch (error) {
      const message = error instanceof Error ? error.message : "MCP request failed";
      setMcpStatus("error");
      setMcpMessage(message);
      toast.error({ title: "Application MCP failed", description: message });
    }
  }, [toast]);

  const runNative = useCallback(
    async (action: () => Promise<FIANativeState>, successTitle: string) => {
      try {
        const state = await action();
        setDesktopState(state);
        setNativeStatus("success");
        setNativeMessage(
          `${state.mode} mode · ${state.window.alwaysOnTop ? "floating" : "normal"} window`,
        );
        toast.success({ title: successTitle, description: "The native window state is up to date." });
      } catch (error) {
        const message = error instanceof Error ? error.message : "Native MCP command failed";
        setNativeStatus("error");
        setNativeMessage(message);
        toast.error({ title: "Native command failed", description: message });
      }
    },
    [toast],
  );

  useEffect(() => {
    if (!native.isAvailable()) {
      setNativeMessage("Native MCP bridge unavailable outside the FIA Host.");
      return;
    }
    void native
      .getState()
      .then((state) => {
        setDesktopState(state);
        setNativeStatus("success");
        setNativeMessage(`${state.mode} mode · native MCP ready`);
      })
      .catch((error: unknown) => {
        setNativeStatus("error");
        setNativeMessage(error instanceof Error ? error.message : "Native MCP failed");
      });
  }, []);

  return (
    <main className="mx-auto min-h-screen w-[min(1040px,calc(100%-48px))] pt-6 pb-8 max-[720px]:w-[min(calc(100%-28px),560px)] max-[720px]:pt-4">
      <nav className="flex min-h-10 items-center justify-between gap-4" aria-label="Application">
        <div className="flex items-center gap-[9px] text-[13px] font-[680] tracking-[-0.01em]">
          <span className="inline-flex size-7 items-center justify-center rounded-ui-md bg-ui-accent text-ui-on-accent">
            <Sparkles size={15} />
          </span>
          <span>FIA</span>
        </div>
        <ThemeMenu />
      </nav>

      <header className="max-w-[760px] pt-[clamp(72px,12vh,120px)] pb-16 max-[720px]:pt-14 max-[720px]:pb-11">
        <Badge tone="accent">FIA Framework · MCP 2026-07-28</Badge>
        <h1 className="mt-[22px] mb-4 text-[clamp(44px,7vw,76px)] leading-[0.98] font-[680] tracking-[-0.055em] text-ui-text max-[720px]:text-5xl">
          __FIA_DISPLAY_NAME__
        </h1>
        <p className="m-0 max-w-[680px] text-base leading-[1.7] text-ui-text-muted max-[720px]:text-sm">
          A static React interface with accessible preset components, Bun-powered MCP extensions,
          and a native Swift host.
        </p>
      </header>

      <section
        className="grid grid-cols-2 gap-4 max-[720px]:grid-cols-1"
        aria-label="Framework checks"
      >
        <article className="flex min-h-[292px] min-w-0 flex-col items-start rounded-ui-lg border border-ui-border bg-ui-surface p-5">
          <div className="flex w-full items-center justify-between gap-4">
            <span className="inline-flex size-9 items-center justify-center rounded-ui-md bg-ui-accent-soft text-ui-accent-text">
              <Radio size={18} />
            </span>
            <Badge tone={statusTone[mcpStatus]} dot>
              {mcpStatus}
            </Badge>
          </div>
          <div className="flex-1 py-6 pt-[30px]">
            <span className="text-[10px] font-[680] tracking-[0.08em] text-ui-text-faint uppercase">
              Application MCP
            </span>
            <h2 className="my-2 text-xl font-[680] tracking-[-0.025em]">Typed greeting</h2>
            <p className="m-0 leading-relaxed text-ui-text-muted">{mcpMessage}</p>
          </div>
          <Button variant="primary" onClick={callApp}>
            Call greet
          </Button>
        </article>

        <article className="flex min-h-[292px] min-w-0 flex-col items-start rounded-ui-lg border border-ui-border bg-ui-surface p-5">
          <div className="flex w-full items-center justify-between gap-4">
            <span className="inline-flex size-9 items-center justify-center rounded-ui-md bg-ui-accent-soft text-ui-accent-text">
              <AppWindow size={18} />
            </span>
            <Badge tone={statusTone[nativeStatus]} dot>
              {nativeStatus}
            </Badge>
          </div>
          <div className="flex-1 py-6 pt-[30px]">
            <span className="text-[10px] font-[680] tracking-[0.08em] text-ui-text-faint uppercase">
              fia.native
            </span>
            <h2 className="my-2 text-xl font-[680] tracking-[-0.025em]">Desktop shell</h2>
            <p className="m-0 leading-relaxed text-ui-text-muted">{nativeMessage}</p>
          </div>
          <div className="flex flex-wrap gap-2">
            <Button
              disabled={desktopState === null}
              onClick={() =>
                void runNative(
                  () => native.window.setAlwaysOnTop(!desktopState!.window.alwaysOnTop),
                  "Window mode updated",
                )
              }
            >
              <PanelTop size={15} />
              Toggle floating
            </Button>
            <Button
              disabled={desktopState === null}
              onClick={() =>
                void runNative(
                  () => native.statusBar.setVisible(!desktopState!.statusBarVisible),
                  "Status item updated",
                )
              }
            >
              Toggle status item
            </Button>
          </div>
        </article>
      </section>

      <footer className="mt-10 flex min-h-24 items-center justify-between gap-5 border-t border-ui-border text-[11px] text-ui-text-muted max-[720px]:flex-col max-[720px]:items-start max-[720px]:justify-center max-[720px]:gap-2.5">
        <span>Static UI · MCP stdio extensions · no production Bun dependency</span>
        <Tooltip content="Editable source in src/ui/components/ui">
          <Badge>Tailwind CSS v4 preset</Badge>
        </Tooltip>
      </footer>
    </main>
  );
}
