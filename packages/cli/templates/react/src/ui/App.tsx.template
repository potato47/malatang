import { useCallback, useEffect, useState } from "react";
import { Moon, Monitor, Radio, Sparkles, Sun } from "lucide-react";
import { Badge, Button, IconButton, Menu, useTheme, useToast } from "./components/ui";

function ThemeMenu() {
  const { theme, resolvedTheme, setTheme } = useTheme();
  const ThemeIcon = resolvedTheme === "dark" ? Moon : Sun;
  return (
    <Menu
      trigger={<IconButton variant="ghost" aria-label="Change color theme"><ThemeIcon size={16} /></IconButton>}
      items={[
        { id: "theme-system", label: "System", icon: <Monitor size={14} />, checked: theme === "system", onSelect: () => setTheme("system") },
        { id: "theme-light", label: "Light", icon: <Sun size={14} />, checked: theme === "light", onSelect: () => setTheme("light") },
        { id: "theme-dark", label: "Dark", icon: <Moon size={14} />, checked: theme === "dark", onSelect: () => setTheme("dark") },
      ]}
    />
  );
}

export function App() {
  const toast = useToast();
  const [message, setMessage] = useState("Ready to call the Bun backend over HTTP.");
  const [socketStatus, setSocketStatus] = useState("connecting");

  useEffect(() => {
    const url = new URL("/ws", location.href);
    url.protocol = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(url);
    socket.addEventListener("open", () => setSocketStatus("connected"));
    socket.addEventListener("close", () => setSocketStatus("closed"));
    return () => socket.close();
  }, []);

  const greet = useCallback(async () => {
    try {
      const response = await fetch("/api/greet");
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = await response.json() as { message: string; timestamp: string };
      setMessage(`${result.message} · ${new Date(result.timestamp).toLocaleTimeString()}`);
      toast.success({ title: "Backend responded", description: result.message });
    } catch (error) {
      const detail = error instanceof Error ? error.message : "Request failed";
      setMessage(detail);
      toast.error({ title: "HTTP request failed", description: detail });
    }
  }, [toast]);

  return (
    <main className="mx-auto min-h-screen w-[min(920px,calc(100%-48px))] pt-6 pb-8">
      <nav className="flex items-center justify-between">
        <div className="flex items-center gap-2 font-semibold"><Sparkles size={17} /> FIA</div>
        <ThemeMenu />
      </nav>
      <header className="pt-[clamp(72px,12vh,120px)] pb-14">
        <Badge tone="accent">Resident Bun service · HTTP + WebSocket</Badge>
        <h1 className="mt-6 mb-4 text-[clamp(44px,7vw,72px)] leading-none font-semibold tracking-[-0.05em]">__FIA_DISPLAY_NAME__</h1>
        <p className="max-w-[680px] leading-7 text-ui-text-muted">The React page uses standard browser protocols. Native APIs only exist inside the Bun backend.</p>
      </header>
      <section className="rounded-ui-lg border border-ui-border bg-ui-surface p-6">
        <div className="mb-6 flex items-center justify-between">
          <Radio size={20} />
          <Badge dot tone={socketStatus === "connected" ? "success" : "neutral"}>{socketStatus}</Badge>
        </div>
        <p className="mb-6 text-ui-text-muted">{message}</p>
        <Button variant="primary" onClick={() => void greet()}>Call HTTP API</Button>
      </section>
    </main>
  );
}
