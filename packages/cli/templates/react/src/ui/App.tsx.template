import { useCallback, useEffect, useState } from "react";
import { mcp } from "@semicoder/fia/mcp";
import { native, type FIANativeState } from "@semicoder/fia/native";
import type { Greeting } from "../shared/types";

type Status = "idle" | "working" | "success" | "error";

export function App() {
  const [mcpStatus, setMcpStatus] = useState<Status>("idle");
  const [mcpMessage, setMcpMessage] = useState("Ready to call the bundled application MCP server.");
  const [nativeStatus, setNativeStatus] = useState<Status>("idle");
  const [nativeMessage, setNativeMessage] = useState("Checking the FIA native MCP server …");
  const [desktopState, setDesktopState] = useState<FIANativeState | null>(null);

  const callApp = useCallback(async () => {
    setMcpStatus("working");
    try {
      const result = await mcp.server("app").callTool({
        name: "greet",
        arguments: { name: "FIA" },
      });
      const greeting = result.structuredContent as Greeting;
      setMcpStatus("success");
      setMcpMessage(`${greeting.message} · ${new Date(greeting.timestamp).toLocaleTimeString()}`);
    } catch (error) {
      setMcpStatus("error");
      setMcpMessage(error instanceof Error ? error.message : "MCP request failed");
    }
  }, []);

  const runNative = useCallback(async (action: () => Promise<FIANativeState>) => {
    setNativeStatus("working");
    try {
      const state = await action();
      setDesktopState(state);
      setNativeStatus("success");
      setNativeMessage(`${state.mode} mode · ${state.window.alwaysOnTop ? "floating" : "normal"} window`);
    } catch (error) {
      setNativeStatus("error");
      setNativeMessage(error instanceof Error ? error.message : "Native MCP command failed");
    }
  }, []);

  useEffect(() => {
    if (!native.isAvailable()) {
      setNativeMessage("Native MCP bridge unavailable outside the FIA Host.");
      return;
    }
    void native.getState().then((state) => {
      setDesktopState(state);
      setNativeStatus("success");
      setNativeMessage(`${state.mode} mode · native MCP ready`);
    }).catch((error: unknown) => {
      setNativeStatus("error");
      setNativeMessage(error instanceof Error ? error.message : "Native MCP failed");
    });
  }, []);

  return (
    <main>
      <header className="hero">
        <div className="eyebrow">FIA Framework · MCP 2026-07-28</div>
        <h1>__FIA_DISPLAY_NAME__</h1>
        <p>A static React UI with Bun-powered MCP extensions and a native Swift host.</p>
      </header>

      <section className="grid" aria-label="MCP checks">
        <article className={`card ${mcpStatus}`}>
          <span className="badge">App MCP</span>
          <h2>Typed greeting</h2>
          <p>{mcpMessage}</p>
          <button type="button" onClick={callApp} disabled={mcpStatus === "working"}>
            Call greet
          </button>
        </article>

        <article className={`card ${nativeStatus}`}>
          <span className="badge">fia.native</span>
          <h2>Desktop shell</h2>
          <p>{nativeMessage}</p>
          <div className="actions">
            <button
              type="button"
              disabled={nativeStatus === "working" || desktopState === null}
              onClick={() => void runNative(() => native.window.setAlwaysOnTop(!desktopState!.window.alwaysOnTop))}
            >
              Toggle floating
            </button>
            <button
              type="button"
              disabled={nativeStatus === "working" || desktopState === null}
              onClick={() => void runNative(() => native.statusBar.setVisible(!desktopState!.statusBarVisible))}
            >
              Toggle status item
            </button>
          </div>
        </article>
      </section>

      <footer>Static UI · MCP stdio extensions · no production Bun dependency</footer>
    </main>
  );
}
