import { useCallback, useEffect, useRef, useState } from "react";
import { native, type FIANativeState } from "@semicoder/fia/native";

type Status = "idle" | "working" | "success" | "error";

interface HelloResponse {
  message: string;
  timestamp: string;
}

export function App() {
  const [httpStatus, setHTTPStatus] = useState<Status>("idle");
  const [httpMessage, setHTTPMessage] = useState("Ready to call the Bun backend.");
  const [socketStatus, setSocketStatus] = useState<Status>("idle");
  const [socketMessage, setSocketMessage] = useState("Ready to open an application WebSocket.");
  const [nativeStatus, setNativeStatus] = useState<Status>("idle");
  const [nativeMessage, setNativeMessage] = useState("Checking the FIA native bridge …");
  const [desktopState, setDesktopState] = useState<FIANativeState | null>(null);
  const socketRef = useRef<WebSocket | null>(null);

  const callHello = useCallback(async () => {
    setHTTPStatus("working");
    setHTTPMessage("Requesting /api/hello …");
    try {
      const response = await fetch("/api/hello");
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = await response.json() as HelloResponse;
      setHTTPStatus("success");
      setHTTPMessage(`${result.message} · ${new Date(result.timestamp).toLocaleTimeString()}`);
    } catch (error) {
      setHTTPStatus("error");
      setHTTPMessage(error instanceof Error ? error.message : "Request failed");
    }
  }, []);

  const sendEcho = useCallback(() => {
    socketRef.current?.close();
    setSocketStatus("working");
    setSocketMessage("Connecting to /ws …");
    const protocol = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(`${protocol}//${location.host}/ws`);
    socketRef.current = socket;
    socket.addEventListener("open", () => {
      socket.send(JSON.stringify({ id: crypto.randomUUID(), message: "Hello over WebSocket" }));
    });
    socket.addEventListener("message", (event) => {
      const response = JSON.parse(String(event.data)) as { echo: string };
      setSocketStatus("success");
      setSocketMessage(response.echo);
      socket.close();
    });
    socket.addEventListener("error", () => {
      setSocketStatus("error");
      setSocketMessage("WebSocket connection failed");
    });
  }, []);

  const runNative = useCallback(async (action: () => Promise<FIANativeState>) => {
    setNativeStatus("working");
    try {
      const state = await action();
      setDesktopState(state);
      setNativeStatus("success");
      setNativeMessage(`${state.mode} mode · ${state.window.alwaysOnTop ? "floating" : "normal"} window`);
    } catch (error) {
      setNativeStatus("error");
      setNativeMessage(error instanceof Error ? error.message : "Native command failed");
    }
  }, []);

  useEffect(() => {
    if (!native.isAvailable()) {
      setNativeMessage("Native bridge unavailable outside the FIA Host.");
      return;
    }
    let active = true;
    const update = (state: FIANativeState) => {
      if (!active) return;
      setDesktopState(state);
      setNativeStatus("success");
      setNativeMessage(`${state.mode} mode · secure native bridge ready`);
    };
    const unsubscribe = native.onEvent((event) => {
      if (event.type === "stateChanged") update(event.state);
    });
    void native.getState().then(update).catch((error: unknown) => {
      if (!active) return;
      setNativeStatus("error");
      setNativeMessage(error instanceof Error ? error.message : "Native bridge failed");
    });
    return () => {
      active = false;
      unsubscribe();
    };
  }, []);

  useEffect(() => () => socketRef.current?.close(), []);

  return (
    <main>
      <header className="hero">
        <div className="eyebrow">FIA Framework · React</div>
        <h1>__FIA_DISPLAY_NAME__</h1>
        <p>A minimal Bun full-stack scaffold, ready for your desktop UI.</p>
      </header>

      <section className="grid" aria-label="Runtime checks">
        <article className={`card ${httpStatus}`}>
          <span className="badge">HTTP</span>
          <h2>Hello endpoint</h2>
          <p>{httpMessage}</p>
          <button type="button" onClick={callHello} disabled={httpStatus === "working"}>
            Call API
          </button>
        </article>

        <article className={`card ${socketStatus}`}>
          <span className="badge">WebSocket</span>
          <h2>Echo channel</h2>
          <p>{socketMessage}</p>
          <button type="button" onClick={sendEcho} disabled={socketStatus === "working"}>
            Send echo
          </button>
        </article>


        <article className={`card ${nativeStatus}`}>
          <span className="badge">Native</span>
          <h2>Desktop shell</h2>
          <p>{nativeMessage}</p>
          <div className="actions">
            <button
              type="button"
              disabled={nativeStatus === "working" || desktopState === null}
              onClick={() => void runNative(() => native.window.setAlwaysOnTop(!desktopState!.window.alwaysOnTop))}
            >
              Toggle floating
            </button>
            <button
              type="button"
              disabled={nativeStatus === "working" || desktopState === null}
              onClick={() => void runNative(() => native.statusBar.setVisible(!desktopState!.statusBarVisible))}
            >
              Toggle status item
            </button>
          </div>
        </article>
      </section>

      <footer>FIA managed runtime · secure local session · React hot reload</footer>
    </main>
  );
}
