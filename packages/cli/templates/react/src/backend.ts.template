import { defineBackend } from "@semicoder/fia/backend";
import index from "./ui/index.html";

interface SocketData {
  connectedAt: number;
}

export default defineBackend<SocketData>()({
  http: {
    publicRoutes: { "/": index },
    routes: {
      "/api/greet": {
        GET: () => Response.json({
          message: "Hello from the resident Bun backend!",
          timestamp: new Date().toISOString(),
        }),
      },
      "/ws": (request, server) => {
        if (server.upgrade(request, { data: { connectedAt: Date.now() } })) return;
        return new Response("WebSocket upgrade failed", { status: 400 });
      },
    },
    websocket: {
      open(socket) {
        socket.send(JSON.stringify({ type: "ready", connectedAt: socket.data.connectedAt }));
      },
      message(socket, message) {
        socket.send(message);
      },
    },
  },
  async start({ desktop, url }) {
    await desktop.tray.setMenu([
      { item: { id: "open-window", label: "Open Window", symbol: "macwindow" } },
      { item: { id: "open-browser", label: "Open in Browser", symbol: "safari" } },
    ]);
    const openWindow = () =>
      desktop.windows.create({ id: "main", url: url("/"), title: __FIA_APP_NAME_JSON__ });
    desktop.tray.addEventListener("click", () => void openWindow());
    desktop.tray.addEventListener("menuclick", ({ detail }) => {
      if (detail.id === "open-window") void openWindow();
      if (detail.id === "open-browser") void desktop.system.openURL(url("/"));
    });
  },
});
