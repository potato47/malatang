import { useCallback, useEffect, useState } from "react";

type SocketStatus = "connecting" | "connected" | "closed";

export function App() {
  const [message, setMessage] = useState("Ready to call the Bun backend over HTTP.");
  const [socketStatus, setSocketStatus] = useState<SocketStatus>("connecting");
  const [requesting, setRequesting] = useState(false);

  useEffect(() => {
    const url = new URL("/ws", location.href);
    url.protocol = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(url);
    socket.addEventListener("open", () => setSocketStatus("connected"));
    socket.addEventListener("close", () => setSocketStatus("closed"));
    return () => socket.close();
  }, []);

  const greet = useCallback(async () => {
    setRequesting(true);
    try {
      const response = await fetch("/api/greet");
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = (await response.json()) as { message: string; timestamp: string };
      setMessage(`${result.message} · ${new Date(result.timestamp).toLocaleTimeString()}`);
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Request failed");
    } finally {
      setRequesting(false);
    }
  }, []);

  return (
    <main className="mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center px-6 py-16">
      <p className="mb-4 text-sm font-medium tracking-wide text-blue-600 uppercase dark:text-blue-400">
        Resident Bun service · HTTP + WebSocket
      </p>
      <h1 className="text-4xl font-semibold tracking-tight text-zinc-950 sm:text-6xl dark:text-white">
        __FIA_DISPLAY_NAME__
      </h1>
      <p className="mt-5 max-w-2xl text-base leading-7 text-zinc-600 dark:text-zinc-300">
        This React page uses standard browser protocols. Native desktop APIs stay inside the Bun
        backend.
      </p>

      <section className="mt-10 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div className="flex items-center justify-between gap-4">
          <h2 className="font-medium text-zinc-950 dark:text-white">Backend connection</h2>
          <span className="inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300">
            <span
              className={`size-2 rounded-full ${socketStatus === "connected" ? "bg-emerald-500" : "bg-amber-500"}`}
            />
            WebSocket {socketStatus}
          </span>
        </div>
        <p className="mt-5 min-h-6 text-sm text-zinc-600 dark:text-zinc-300">{message}</p>
        <button
          className="mt-6 rounded-lg bg-zinc-950 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
          disabled={requesting}
          onClick={() => void greet()}
          type="button"
        >
          {requesting ? "Calling…" : "Call HTTP API"}
        </button>
      </section>
    </main>
  );
}
