import FIABackend
import Foundation

private struct GreetRequest: Codable, Sendable {
    let name: String
}

private struct GreetResponse: Codable, Sendable {
    let message: String
    let timestamp: Date
}

@main
struct __FIA_SWIFT_PRODUCT__ {
    static func main() async throws {
        let application = BackendApplication()
        application.handle(
            "greet",
            input: GreetRequest.self,
            output: GreetResponse.self
        ) { request, context in
            context.logger.info("Greeting \(request.name)")
            try await context.emit(name: "greet.completed", payload: ["name": request.name])
            return GreetResponse(message: "Hello, \(request.name)!", timestamp: .now)
        }
        try await application.run()
    }
}
