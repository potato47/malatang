{
  "name": "@semicoder/fia",
  "version": "0.6.3",
  "description": "Command-line tools for building FIA macOS applications",
  "bin": {
    "fia": "bin/fia"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "assets",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./mcp/server": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js",
      "default": "./dist/mcp-server.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --outfile=dist/index.js && bun build src/config.ts --target=bun --outfile=dist/config.js && bun build src/mcp.ts --target=browser --outfile=dist/mcp.js && bun build src/mcp-server.ts --target=bun --outfile=dist/mcp-server.js && bun build src/native.ts --target=browser --outfile=dist/native.js && bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "test": "bun run build && bun test tests",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
