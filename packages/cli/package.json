{
  "name": "@semicoder/fia",
  "version": "2.0.0",
  "description": "Build Swift-first composable macOS applications",
  "bin": {
    "fia": "bin/fia"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.js",
      "default": "./dist/backend.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=bun --outfile=dist/index.js && bun build src/client.ts --target=browser --outfile=dist/client.js && bun build src/backend.ts --target=bun --outfile=dist/backend.js && bun build src/vite.ts --target=bun --outfile=dist/vite.js --external vite && bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "test": "bun run build && bun test tests",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.1.18",
    "vite": "^7.1.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
