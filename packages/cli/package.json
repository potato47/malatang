{
  "name": "@fia/cli",
  "version": "0.1.0",
  "description": "Command-line tools for building FIA macOS applications",
  "type": "module",
  "bin": {
    "fia": "bin/fia"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "test": "bun run build && bun test tests",
    "prepack": "bun run build"
  }
}
