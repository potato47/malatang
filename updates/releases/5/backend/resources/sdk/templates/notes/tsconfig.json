{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "src",
    "tools.ts"
  ]
}
