{
  "name": "fia-framework",
  "version": "0.16.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "fia": "bun run packages/cli/src/index.ts",
    "cli:build": "bun run --cwd packages/cli build",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:cli": "bun run cli:build && bun test packages/cli/tests",
    "test:swift": "CLANG_MODULE_CACHE_PATH=\"$PWD/.build/module-cache\" SWIFTPM_MODULECACHE_OVERRIDE=\"$PWD/.build/module-cache\" swift test --disable-sandbox",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test:cli && bun run test:swift",
    "release": "bun run tools/publish-npm.ts",
    "runtime:build": "bun tools/build-runtime.ts",
    "smoke": "bun tools/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
