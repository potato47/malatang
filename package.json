{
  "name": "fia-framework",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "fia": "bun run packages/cli/src/index.ts",
    "cli:build": "bun run --cwd packages/cli build",
    "ui:build": "bun run tools/build-ui.ts",
    "typecheck": "bun run ui:build && tsc --noEmit",
    "test:cli": "bun run cli:build && bun test packages/cli/tests",
    "test:runtime": "bun test prototype/runtime/tests",
    "test:host": "swift test --package-path host",
    "test:swift-backend": "swift test --package-path packages/cli/swift",
    "host:package": "bun run tools/package-host.ts",
    "prototype:build": "bun run tools/build-prototype.ts",
    "prototype:verify": "bun run tools/verify-prototype.ts",
    "prototype:lifecycle": "bun run tools/test-lifecycle.ts",
    "check": "bun run typecheck && bun run test:cli && bun run test:runtime && bun run test:host && bun run test:swift-backend",
    "version:npm": "bun run tools/version-npm.ts",
    "release:npm": "bun run tools/publish-npm.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
